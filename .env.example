# Copy to .env and fill in. Never commit .env.
#
# Local development needs only BETTER_AUTH_SECRET and ADMIN_EMAILS to be usable:
# the database falls back to an embedded PGlite instance, and the login page
# offers an email and password form until OAuth clients exist.
#
# On the server this file lives at /var/www/osw/.env, chmod 600, and is read by
# docker compose. See the Deployment section of the README.

# --- Content source -----------------------------------------------------------
# 'sheet' reads events/jobs from the published Google Sheet CSVs (legacy),
# 'db' reads them from Postgres.
#
# Deploy with 'sheet' so nothing visible changes, then import the sheets from
# /admin, check the pages, and only then switch to 'db' and restart. Rolling back
# is the same one-line change in reverse.
CONTENT_SOURCE=sheet

# The published-to-web CSV URLs. Still needed after the switch to 'db' so the
# importer can be re-run; safe to drop once the sheets are retired for good.
GOOGLE_EVENTS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv
GOOGLE_JOBS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv

# --- Database -----------------------------------------------------------------
# Leave unset for local development: the app uses an embedded PGlite database in
# .pglite/, so no database server is required.
#
# docker compose sets this for the app and migrate services from POSTGRES_PASSWORD
# below, so it does not need to be set by hand on the server.
# DATABASE_URL=postgres://osw:password@localhost:5432/osw

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Changing this in production signs every member out.
BETTER_AUTH_SECRET=

# Must be the exact public origin in production, or OAuth redirects break and
# secure cookies are dropped. Production: https://opensourceweekend.org
BETTER_AUTH_URL=http://localhost:4321

# Comma separated emails promoted to admin on sign in. This is how the first
# admin account is created; there is no other way in.
ADMIN_EMAILS=

# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URIs (add both to the same client):
#   http://localhost:4321/api/auth/callback/google
#   https://opensourceweekend.org/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub -> Settings -> Developer settings -> OAuth Apps.
# GitHub allows a single callback URL per app, so create TWO apps with separate
# secrets, one per environment:
#   dev  -> http://localhost:4321/api/auth/callback/github
#   prod -> https://opensourceweekend.org/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email --------------------------------------------------------------------
# Resend is used over SMTP because VPS providers commonly block the SMTP ports.
# Optional: without it, notification emails are skipped rather than failing.
RESEND_API_KEY=
EMAIL_FROM=noreply@opensourceweekend.org
ADMIN_NOTIFY_EMAIL=opensourceweekend@gmail.com

# --- Production only (docker compose) -----------------------------------------
# Password for the Postgres container. Set this before the first deploy: the
# database volume is initialised with it, and changing it later does not change
# the password already stored in the volume.
POSTGRES_PASSWORD=

# Reminder for the reverse proxy in front of the app (nginx or Caddy):
#   proxy_set_header Host              $host;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   proxy_pass       http://127.0.0.1:3000;
# Without X-Forwarded-Proto the app believes it is on HTTP, secure cookies are
# silently dropped, and sign in redirect-loops.
