---
import { Calendar, Clock, ExternalLink } from 'lucide-astro';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import IconText from './ui/IconText.astro';
import type { Event } from '../data/events';

interface Props {
  event: Event;
}

const { event } = Astro.props;

const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
};

const formatTime = (start: string, end: string) => {
  const s = new Date(start).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  const e = new Date(end).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  return `${s} - ${e}`;
};
---

<div class="group relative bg-card hover:bg-card/50 border border-border rounded-xl p-5 transition-all hover:shadow-md flex flex-col gap-4">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <Badge variant="secondary" class="rounded-full">
          {event.type || 'Event'}
        </Badge>
        <Badge variant="outline" class="rounded-full font-mono text-xs">
          {formatDate(event.startDate)}
        </Badge>
      </div>

      <a href={event.link} target="_blank" class="block">
        <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors line-clamp-2">
          {event.title}
        </h3>
      </a>
      
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
        <IconText icon={Clock}>
          {formatTime(event.startDate, event.endDate)}
        </IconText>
        {event.location && (
            <span>📍 {event.location}</span>
        )}
      </div>
    </div>
  </div>

  <div class="pt-2 mt-auto">
    <Button href={event.link} variant="outline" size="sm" class="w-full gap-2 rounded-lg group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all duration-300">
      Visit Event
      <ExternalLink class="size-3.5" />
    </Button>
  </div>
</div>
