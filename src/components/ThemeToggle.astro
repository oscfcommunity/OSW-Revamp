---
import { Sun, Moon } from 'lucide-astro';
---

<button
  class="theme-toggle relative p-2 rounded-lg text-muted-foreground hover:bg-muted focus:outline-none focus:ring-2 focus:ring-primary"
  aria-label="Toggle Theme"
>
  <span class="sr-only">Toggle theme</span>
  <!-- Sun icon: Hidden by default (Light Mode), Visible in Dark Mode -->
  <Sun class="size-5 sun-icon hidden" />
  <!-- Moon icon: Visible by default (Light Mode), Hidden in Dark Mode -->
  <Moon class="size-5 moon-icon" />
</button>

<style>
  /* Action Metaphor: 
     - Light Mode: Show Moon (Click to go Dark)
     - Dark Mode: Show Sun (Click to go Light) 
  */
  
  /* In Dark Mode, hide Moon, show Sun */
  :global(.dark) .moon-icon {
    display: none;
  }
  :global(.dark) .sun-icon {
    display: block;
  }
</style>

<script is:inline>
  {
    // Primary Theme Logic (Runs immediately)
    const getTheme = () => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    };

    const theme = getTheme();

    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }

    window.localStorage.setItem('theme', theme);

    // Event Listeners (Wait for DOM)
    const handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle("dark");

      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };

    // Support multiple toggles (desktop & mobile)
    // We use a unique attribute or just attach to all, but prevent double attachment if script runs twice.
    // Actually, simply attaching to all is fine because addEventListener with same args is deduped? 
    // No, arrow functions are different references.
    // Better strategy: Attach only to the buttons *inside* this component instance? 
    // No, script is global. 
    // Safest: Use event delegation or just attach to all and use { once: true }? No.
    // Simple fix: Checks if attached?
    
    // Better: This script runs twice. 
    // Run 1: finds desktop button. attaches.
    // Run 2: finds desktop AND mobile. attaches (again) to desktop, and mobile.
    // Result: Desktop has 2 listeners. Mobile has 1.
    // To prevent this, we can mark them as initialized.
    
    const toggles = document.querySelectorAll(".theme-toggle");
    toggles.forEach(btn => {
        if (!btn.hasAttribute('data-initialized')) {
            btn.addEventListener("click", handleToggleClick);
            btn.setAttribute('data-initialized', 'true');
        }
    });
  }
</script>
