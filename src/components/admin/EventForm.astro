---
import { actions } from 'astro:actions';

import Field from './Field.astro';
import { event } from '../../db/schema/content';

interface Props {
  event?: typeof event.$inferSelect;
  error?: string;
}

const { event: existing, error } = Astro.props;

/** datetime-local inputs need `YYYY-MM-DDTHH:mm` in local time, not an ISO string. */
const toLocalInput = (value: Date | null | undefined): string => {
  if (!value) return '';
  const offset = value.getTimezoneOffset() * 60_000;
  return new Date(value.getTime() - offset).toISOString().slice(0, 16);
};

const toDateInput = (value: Date | null | undefined): string =>
  value ? value.toISOString().slice(0, 10) : '';
---

<form method="POST" action={actions.admin.saveEvent} class="space-y-8">
  {existing && <input type="hidden" name="id" value={existing.id} />}

  {
    error && (
      <p class="border-destructive/20 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
        {error}
      </p>
    )
  }

  <section class="bg-card border-border space-y-5 rounded-xl border p-6">
    <h2 class="font-bold">Basics</h2>
    <Field label="Title" name="title" required value={existing?.title} />
    <Field
      label="Slug"
      name="slug"
      required
      value={existing?.slug}
      hint="Used in the URL: /events/your-slug"
    />
    <div class="grid gap-5 sm:grid-cols-2">
      <Field
        label="Starts"
        name="startDate"
        type="datetime-local"
        required
        value={toLocalInput(existing?.startDate)}
      />
      <Field
        label="Ends"
        name="endDate"
        type="datetime-local"
        value={toLocalInput(existing?.endDate)}
      />
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <Field
        label="Type"
        name="type"
        type="select"
        value={existing?.type ?? 'Meetup'}
        options={['Meetup', 'Workshop', 'Conference', 'Hackathon']}
      />
      <Field
        label="Status"
        name="status"
        type="select"
        value={existing?.status ?? 'published'}
        options={['published', 'draft', 'cancelled']}
      />
    </div>
    <Field
      label="Attendance"
      name="attendanceMode"
      type="select"
      value={existing?.attendanceMode ?? ''}
      options={['', 'In-person', 'Hybrid', 'Online']}
      hint="How people attend. Left blank if unknown."
    />
    <Field
      label="Short description"
      name="description"
      value={existing?.description}
      hint="Shown on cards and in search results."
    />
    <Field
      label="Full description (Markdown)"
      name="longDescription"
      type="textarea"
      value={existing?.longDescription}
    />
  </section>

  <section class="bg-card border-border space-y-5 rounded-xl border p-6">
    <h2 class="font-bold">Where and how</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <Field label="Location (city)" name="location" value={existing?.location} />
      <Field label="Venue label" name="venue" value={existing?.venue} hint="e.g. TBA, or a name." />
    </div>
    <Field label="Venue address" name="venueName" value={existing?.venueName} />
    <Field label="Map link" name="venueMap" type="url" value={existing?.venueMap} />
    <Field label="Event link" name="link" type="url" value={existing?.link} />
    <Field label="Community" name="community" value={existing?.community} />
  </section>

  <section class="bg-card border-border space-y-5 rounded-xl border p-6">
    <h2 class="font-bold">Call for papers</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <Field
        label="CFP status"
        name="cfpStatus"
        type="select"
        value={existing?.cfpStatus ?? 'none'}
        options={['none', 'Open', 'Closed']}
      />
      <Field
        label="CFP closes"
        name="cfpEndDate"
        type="date"
        value={toDateInput(existing?.cfpEndDate)}
      />
    </div>
    <Field label="Featured" name="featured" type="checkbox" value={existing?.featured ?? false} />
  </section>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="bg-primary text-primary-foreground hover:bg-primary/90 h-11 rounded-lg px-6 text-sm font-bold"
    >
      {existing ? 'Save changes' : 'Create event'}
    </button>
    <a href="/admin/events" class="text-muted-foreground hover:text-foreground text-sm">Cancel</a>
  </div>
</form>
