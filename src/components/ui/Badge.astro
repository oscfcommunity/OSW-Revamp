---
interface Props {
  variant?: 'default' | 'outline' | 'secondary' | 'muted';
  class?: string;
}

const { variant = 'muted', class: className } = Astro.props;

const variants = {
  default: 'bg-primary text-primary-foreground border-transparent',
  outline: 'bg-transparent border-border text-foreground',
  secondary: 'bg-secondary text-secondary-foreground border-transparent',
  muted: 'bg-muted/50 text-muted-foreground border-transparent',
};

const baseStyles = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border';
---

<span class:list={[baseStyles, variants[variant], className]}>
  <slot />
</span>
