---
import '../styles/global.css';
import { Github, Twitter, Linkedin, Facebook, Instagram, Menu, X } from 'lucide-astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AccountMenu from '../components/AccountMenu.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Open Source Weekend is a community of developers, designers and open source enthusiasts. Join our events, share knowledge and find your next role.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body
    class="bg-background text-foreground min-h-screen font-['Inter',sans-serif] antialiased transition-colors duration-300"
  >
    <header class="border-border bg-background/80 sticky top-0 z-50 border-b backdrop-blur-sm">
      <div class="mx-auto flex h-24 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="group flex items-center gap-4">
          <!-- Light Mode Logo -->
          <img
            src="/OSW Black.png"
            alt="Open Source Weekend"
            class="h-24 w-auto transition-transform group-hover:scale-105 dark:hidden"
          />
          <!-- Dark Mode Logo -->
          <img
            src="/OSW White.png"
            alt="Open Source Weekend"
            class="hidden h-24 w-auto transition-transform group-hover:scale-105 dark:block"
          />
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden items-center gap-6 md:flex">
          <div class="text-muted-foreground flex items-center gap-6 text-sm font-medium">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <a href="/about" class="hover:text-primary transition-colors">About</a>
            <a href="/events" class="hover:text-primary transition-colors">Events</a>
            <a href="/jobs" class="hover:text-primary transition-colors">Jobs</a>
            <a href="/forum" class="hover:text-primary transition-colors">Forum</a>
          </div>
          <ThemeToggle />
          <AccountMenu />
        </nav>

        <!-- Mobile Menu Button -->
        <div class="flex items-center gap-4 md:hidden">
          <ThemeToggle />
          <button
            id="mobile-menu-btn"
            class="text-muted-foreground hover:text-foreground -mr-2 p-2"
            aria-label="Open Menu"
          >
            <Menu class="size-6" />
          </button>
        </div>
      </div>

      <!-- Mobile Menu Overlay -->
      <div id="mobile-menu" class="border-border bg-background hidden border-t md:hidden">
        <nav class="text-muted-foreground flex flex-col space-y-4 p-4 text-base font-medium">
          <a
            href="/"
            class="hover:bg-muted/50 hover:text-primary block rounded-lg px-4 py-2 transition-colors"
            >Home</a
          >
          <a
            href="/about"
            class="hover:bg-muted/50 hover:text-primary block rounded-lg px-4 py-2 transition-colors"
            >About</a
          >
          <a
            href="/events"
            class="hover:bg-muted/50 hover:text-primary block rounded-lg px-4 py-2 transition-colors"
            >Events</a
          >
          <a
            href="/jobs"
            class="hover:bg-muted/50 hover:text-primary block rounded-lg px-4 py-2 transition-colors"
            >Jobs</a
          >
          <a
            href="/forum"
            class="hover:bg-muted/50 hover:text-primary block rounded-lg px-4 py-2 transition-colors"
            >Forum</a
          >
          <div class="px-4 pt-2"><AccountMenu /></div>
        </nav>
      </div>
    </header>

    <script is:inline>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        const isExpanded = mobileMenu.classList.contains('hidden');
        if (isExpanded) {
          mobileMenu.classList.remove('hidden');
        } else {
          mobileMenu.classList.add('hidden');
        }
      });
    </script>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-border bg-muted/30 mt-auto border-t py-12 md:py-16">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-4">
        <!-- Brand Column -->
        <div class="space-y-4">
          <a href="/" class="block flex items-center gap-3">
            <!-- Light Mode Logo -->
            <img src="/OSW Black.png" alt="Open Source Weekend" class="h-45 w-auto dark:hidden" />
            <!-- Dark Mode Logo -->
            <img
              src="/OSW White.png"
              alt="Open Source Weekend"
              class="hidden h-45 w-auto dark:block"
            />
          </a>
        </div>

        <!-- Quick Links -->
        <div class="space-y-4">
          <h3 class="text-foreground font-['Outfit'] font-bold">Community</h3>
          <ul class="text-muted-foreground space-y-3">
            <li><a href="/about" class="hover:text-primary transition-colors">About Us</a></li>
            <li>
              <a href="/events" class="hover:text-primary transition-colors">Upcoming Events</a>
            </li>
            <li><a href="/jobs" class="hover:text-primary transition-colors">Job Board</a></li>
            <li>
              <a
                href="https://github.com/oscfcommunity"
                target="_blank"
                class="hover:text-primary transition-colors">GitHub Organization</a
              >
            </li>
          </ul>
        </div>

        <!-- Contact & Social -->
        <div class="space-y-4">
          <h3 class="text-foreground font-['Outfit'] font-bold">Connect</h3>
          <ul class="text-muted-foreground space-y-3">
            <li class="flex items-center gap-2">
              <span>📧</span>
              <a
                href="mailto:opensourceweekend@gmail.com"
                class="hover:text-primary transition-colors">opensourceweekend@gmail.com</a
              >
            </li>
            <li class="flex items-center gap-2">
              <span>📞</span>
              <a href="tel:+918980808222" class="hover:text-primary transition-colors"
                >+91 89 8080 8222</a
              >
            </li>
            <li class="flex flex-wrap gap-4 pt-2">
              <a
                href="https://x.com/OSWeekend"
                target="_blank"
                class="text-muted-foreground hover:text-primary transition-colors"
                aria-label="Twitter / X"
              >
                <Twitter class="size-5" />
              </a>
              <a
                href="https://instagram.com/OSWeekend"
                target="_blank"
                class="text-muted-foreground hover:text-primary transition-colors"
                aria-label="Instagram"
              >
                <Instagram class="size-5" />
              </a>
              <a
                href="https://www.facebook.com/OSWeekend"
                target="_blank"
                class="text-muted-foreground hover:text-primary transition-colors"
                aria-label="Facebook"
              >
                <Facebook class="size-5" />
              </a>
              <a
                href="https://www.linkedin.com/company/open-source-weekend"
                target="_blank"
                class="text-muted-foreground hover:text-primary transition-colors"
                aria-label="LinkedIn"
              >
                <Linkedin class="size-5" />
              </a>
              <a
                href="https://github.com/oscfcommunity"
                target="_blank"
                class="text-muted-foreground hover:text-primary transition-colors"
                aria-label="GitHub"
              >
                <Github class="size-5" />
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="border-border text-muted-foreground border-t pt-8 text-center text-sm">
        &copy; {new Date().getFullYear()} Open Source Weekend. All rights reserved.
      </div>
    </footer>
  </body>
</html>
