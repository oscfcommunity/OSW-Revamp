---
import '../styles/global.css';
import { Github, Twitter, Linkedin, Facebook, Instagram } from 'lucide-astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Find your next tech job." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
	</head>
	<body class="min-h-screen bg-background text-foreground transition-colors duration-300 antialiased font-['Inter',sans-serif]">
    <header class="border-b border-border sticky top-0 z-50 bg-background/80 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between">
        <a href="/" class="flex items-center gap-4 group">
          <img src="/logo.png" alt="Open Source Weekend" class="h-20 w-auto group-hover:scale-105 transition-transform drop-shadow-sm dark:bg-white dark:rounded-lg dark:p-1" />
          <span class="text-3xl font-extrabold tracking-tight text-foreground hidden sm:block font-['Outfit'] group-hover:text-primary transition-colors">
            Open Source Weekend
          </span>
        </a>
        <nav class="flex items-center gap-6">
          <div class="hidden md:flex items-center gap-6 text-sm font-medium text-muted-foreground">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <a href="/events" class="hover:text-primary transition-colors">Events</a>
            <a href="/jobs" class="hover:text-primary transition-colors">Jobs</a>
          </div>
          <ThemeToggle />
        </nav>
      </div>
    </header>
		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<slot />
		</main>
    <footer class="border-t border-border bg-muted/30 mt-auto pt-16 pb-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
          
          <!-- Brand Column -->
          <div class="space-y-4">
            <a href="/" class="flex items-center gap-3">
              <img src="/logo.png" alt="Open Source Weekend" class="h-10 w-auto dark:bg-white dark:rounded-md dark:p-1" />
              <span class="text-xl font-bold font-['Outfit']">Open Source Weekend</span>
            </a>
            <p class="text-muted-foreground leading-relaxed max-w-xs">
              A community-driven initiative empowering developers through open source technology, mentorship, and collaboration.
            </p>
          </div>

          <!-- Quick Links -->
          <div class="space-y-4">
            <h3 class="font-bold text-foreground font-['Outfit']">Community</h3>
            <ul class="space-y-3 text-muted-foreground">
              <li><a href="/events" class="hover:text-primary transition-colors">Upcoming Events</a></li>
              <li><a href="/jobs" class="hover:text-primary transition-colors">Job Board</a></li>
              <li><a href="https://github.com/oscfcommunity" target="_blank" class="hover:text-primary transition-colors">GitHub Organization</a></li>
            </ul>
          </div>

          <!-- Contact & Social -->
          <div class="space-y-4">
            <h3 class="font-bold text-foreground font-['Outfit']">Connect</h3>
            <ul class="space-y-3 text-muted-foreground">
              <li class="flex items-center gap-2">
                <span>📧</span>
                <a href="mailto:opensourceweekend@gmail.com" class="hover:text-primary transition-colors">opensourceweekend@gmail.com</a>
              </li>
              <li class="flex items-center gap-2">
                <span>📞</span>
                <a href="tel:+918980808222" class="hover:text-primary transition-colors">+91 89 8080 8222</a>
              </li>
              <li class="pt-2 flex flex-wrap gap-4">
                <a href="https://x.com/OSWeekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Twitter / X">
                  <Twitter class="size-5" />
                </a>
                <a href="https://instagram.com/OSWeekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Instagram">
                  <Instagram class="size-5" />
                </a>
                <a href="https://www.facebook.com/OSWeekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Facebook">
                  <Facebook class="size-5" />
                </a>
                <a href="https://www.linkedin.com/company/open-source-weekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="LinkedIn">
                  <Linkedin class="size-5" />
                </a>
                <a href="https://github.com/oscfcommunity" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="GitHub">
                  <Github class="size-5" />
                </a>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="border-t border-border pt-8 text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} Open Source Weekend. All rights reserved.
        </div>
      </div>
    </footer>
	</body>
</html>
