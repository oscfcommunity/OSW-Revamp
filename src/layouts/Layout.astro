---
import '../styles/global.css';
import { Github, Twitter, Linkedin, Facebook, Instagram, Menu, X } from 'lucide-astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Find your next tech job." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
	</head>
	<body class="min-h-screen bg-background text-foreground transition-colors duration-300 antialiased font-['Inter',sans-serif]">
    <header class="border-b border-border sticky top-0 z-50 bg-background/80 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between">
        <a href="/" class="flex items-center gap-4 group">
          <!-- Light Mode Logo -->
          <img src="/OSW Black.png" alt="Open Source Weekend" class="h-24 w-auto dark:hidden transition-transform group-hover:scale-105" />
          <!-- Dark Mode Logo -->
          <img src="/OSW White.png" alt="Open Source Weekend" class="h-24 w-auto hidden dark:block transition-transform group-hover:scale-105" />
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-6">
          <div class="flex items-center gap-6 text-sm font-medium text-muted-foreground">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <a href="/about" class="hover:text-primary transition-colors">About</a>
            <a href="/events" class="hover:text-primary transition-colors">Events</a>
            <a href="/jobs" class="hover:text-primary transition-colors">Jobs</a>
          </div>
          <ThemeToggle />
        </nav>

        <!-- Mobile Menu Button -->
        <div class="flex items-center gap-4 md:hidden">
            <ThemeToggle />
            <button id="mobile-menu-btn" class="p-2 -mr-2 text-muted-foreground hover:text-foreground" aria-label="Open Menu">
                <Menu class="size-6" />
            </button>
        </div>
      </div>

      <!-- Mobile Menu Overlay -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-background">
          <nav class="flex flex-col p-4 space-y-4 text-base font-medium text-muted-foreground">
            <a href="/" class="block px-4 py-2 hover:bg-muted/50 rounded-lg hover:text-primary transition-colors">Home</a>
            <a href="/about" class="block px-4 py-2 hover:bg-muted/50 rounded-lg hover:text-primary transition-colors">About</a>
            <a href="/events" class="block px-4 py-2 hover:bg-muted/50 rounded-lg hover:text-primary transition-colors">Events</a>
            <a href="/jobs" class="block px-4 py-2 hover:bg-muted/50 rounded-lg hover:text-primary transition-colors">Jobs</a>
          </nav>
      </div>
    </header>

    <script is:inline>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn?.addEventListener('click', () => {
            const isExpanded = mobileMenu.classList.contains('hidden');
            if (isExpanded) {
                mobileMenu.classList.remove('hidden');
            } else {
                mobileMenu.classList.add('hidden');
            }
        });
    </script>
		<main class="flex-1">
			<slot />
		</main>
    <footer class="border-t border-border bg-muted/30 py-12 md:py-16 mt-auto">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-4 gap-12">
          
          <!-- Brand Column -->
          <div class="space-y-4">
            <a href="/" class="flex items-center gap-3 block">
               <!-- Light Mode Logo -->
              <img src="/OSW Black.png" alt="Open Source Weekend" class="h-45 w-auto dark:hidden" />
              <!-- Dark Mode Logo -->
              <img src="/OSW White.png" alt="Open Source Weekend" class="h-45 w-auto hidden dark:block" />
            </a>
          </div>

          <!-- Quick Links -->
          <div class="space-y-4">
            <h3 class="font-bold text-foreground font-['Outfit']">Community</h3>
            <ul class="space-y-3 text-muted-foreground">
              <li><a href="/about" class="hover:text-primary transition-colors">About Us</a></li>
              <li><a href="/events" class="hover:text-primary transition-colors">Upcoming Events</a></li>
              <li><a href="/jobs" class="hover:text-primary transition-colors">Job Board</a></li>
              <li><a href="https://github.com/oscfcommunity" target="_blank" class="hover:text-primary transition-colors">GitHub Organization</a></li>
            </ul>
          </div>

          <!-- Contact & Social -->
          <div class="space-y-4">
            <h3 class="font-bold text-foreground font-['Outfit']">Connect</h3>
            <ul class="space-y-3 text-muted-foreground">
              <li class="flex items-center gap-2">
                <span>📧</span>
                <a href="mailto:opensourceweekend@gmail.com" class="hover:text-primary transition-colors">opensourceweekend@gmail.com</a>
              </li>
              <li class="flex items-center gap-2">
                <span>📞</span>
                <a href="tel:+918980808222" class="hover:text-primary transition-colors">+91 89 8080 8222</a>
              </li>
              <li class="pt-2 flex flex-wrap gap-4">
                <a href="https://x.com/OSWeekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Twitter / X">
                  <Twitter class="size-5" />
                </a>
                <a href="https://instagram.com/OSWeekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Instagram">
                  <Instagram class="size-5" />
                </a>
                <a href="https://www.facebook.com/OSWeekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Facebook">
                  <Facebook class="size-5" />
                </a>
                <a href="https://www.linkedin.com/company/open-source-weekend" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="LinkedIn">
                  <Linkedin class="size-5" />
                </a>
                <a href="https://github.com/oscfcommunity" target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="GitHub">
                  <Github class="size-5" />
                </a>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="border-t border-border pt-8 text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} Open Source Weekend. All rights reserved.
        </div>
      </div>
    </footer>
	</body>
</html>
