---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | Open Source Weekend">
  <div class="space-y-20 pb-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-20">
      <div
        class="bg-primary/10 pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[100px]"
      >
      </div>
      <div class="mx-auto max-w-4xl space-y-6 px-4 text-center">
        <h1 class="font-['Outfit'] text-4xl font-extrabold tracking-tight md:text-6xl">
          About <span
            class="from-primary to-secondary bg-gradient-to-r bg-clip-text text-transparent"
            >Open Source Weekend</span
          >
        </h1>
        <p class="text-muted-foreground text-xl leading-relaxed">
          An initiative to promote <span class="text-foreground font-medium"
            >Open Source Technology</span
          >, foster collaborative participation, and build bridges between communities and industry.
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-5xl space-y-24 px-4">
      <!-- Mission & Vision -->
      <section class="grid items-center gap-12 md:grid-cols-2">
        <div class="space-y-6">
          <h2 class="font-['Outfit'] text-3xl font-bold">
            Vision & <span class="text-primary">Mission</span>
          </h2>
          <div class="prose prose-lg dark:prose-invert text-muted-foreground leading-relaxed">
            <p>
              Our vision is to provide an Open Ecosystem to learn and grow as professionals. We
              bring together Open Source advocates, enthusiasts, passionate developers, business
              leaders, and students to discuss how to contribute to the ever-evolving world of open
              source.
            </p>
            <p>
              We organize events <span class="text-foreground font-semibold">every Weekend</span> to provide
              a platform for learning, sharing knowledge, collaborating, and networking with like-minded
              individuals.
            </p>
          </div>
        </div>
        <div class="bg-muted/30 border-border relative overflow-hidden rounded-2xl border p-8">
          <div class="bg-secondary/10 absolute -top-10 -right-10 h-32 w-32 rounded-full blur-2xl">
          </div>
          <h3 class="mb-4 font-['Outfit'] text-xl font-bold">Our Core Values</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="bg-primary mt-1 flex h-2 w-2 rounded-full"></span>
              <span>Open Exchange & Transparency</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-secondary mt-1 flex h-2 w-2 rounded-full"></span>
              <span>Collaborative Participation</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-primary mt-1 flex h-2 w-2 rounded-full"></span>
              <span>Rapid Prototyping</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-secondary mt-1 flex h-2 w-2 rounded-full"></span>
              <span>Community-Oriented Development</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Stats & Impact -->
      <section class="bg-card border-border space-y-12 rounded-3xl border p-8 text-center md:p-12">
        <div class="mx-auto max-w-3xl space-y-4">
          <h2 class="font-['Outfit'] text-3xl font-bold">
            Our <span class="text-secondary">Impact</span>
          </h2>
          <p class="text-muted-foreground">
            Started in June 2015 by ComExpo Cyber Security Foundation, "Open Source Weekend" has
            become a movement for software freedom.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          <div class="space-y-2">
            <span class="text-primary block font-['Outfit'] text-4xl font-bold md:text-5xl"
              >300+</span
            >
            <span class="text-muted-foreground text-sm font-medium tracking-wider uppercase"
              >Meetups</span
            >
          </div>
          <div class="space-y-2">
            <span class="text-secondary block font-['Outfit'] text-4xl font-bold md:text-5xl"
              >600+</span
            >
            <span class="text-muted-foreground text-sm font-medium tracking-wider uppercase"
              >Speakers</span
            >
          </div>
          <div class="space-y-2">
            <span class="text-primary block font-['Outfit'] text-4xl font-bold md:text-5xl"
              >5000+</span
            >
            <span class="text-muted-foreground text-sm font-medium tracking-wider uppercase"
              >Attendees</span
            >
          </div>
          <div class="space-y-2">
            <span class="text-secondary block font-['Outfit'] text-4xl font-bold md:text-5xl"
              >100+</span
            >
            <span class="text-muted-foreground text-sm font-medium tracking-wider uppercase"
              >News Features</span
            >
          </div>
        </div>
      </section>

      <!-- Who We Are / Aim -->
      <section class="grid items-start gap-12 md:grid-cols-2">
        <div class="space-y-6">
          <h2 class="font-['Outfit'] text-3xl font-bold">
            Who We Are <span class="text-primary">?</span>
          </h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            OSCF serves as a platform for developers, enthusiasts, and organizations to come
            together, share knowledge, and contribute to open-source projects. We believe in the
            power of open-source software to drive innovation.
          </p>
        </div>
        <div class="space-y-6">
          <h2 class="font-['Outfit'] text-3xl font-bold">
            Our <span class="text-secondary">Aim</span>
          </h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Our mission is to create an inclusive and thriving open-source community that empowers
            developers. We strive to:
          </p>
          <ul class="space-y-4">
            <li class="flex gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 flex-none items-center justify-center rounded-full font-bold"
              >
                1
              </div>
              <span class="text-muted-foreground pt-2"
                >Foster collaboration and knowledge sharing.</span
              >
            </li>
            <li class="flex gap-4">
              <div
                class="bg-secondary/10 text-secondary flex h-10 w-10 flex-none items-center justify-center rounded-full font-bold"
              >
                2
              </div>
              <span class="text-muted-foreground pt-2"
                >Support the development and maintenance of open-source projects.</span
              >
            </li>
            <li class="flex gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 flex-none items-center justify-center rounded-full font-bold"
              >
                3
              </div>
              <span class="text-muted-foreground pt-2"
                >Provide resources and mentorship for aspiring contributors.</span
              >
            </li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Layout>
