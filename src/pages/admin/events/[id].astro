---
import { actions } from 'astro:actions';
import { eq } from 'drizzle-orm';

import AdminLayout from '../../../layouts/AdminLayout.astro';
import EventForm from '../../../components/admin/EventForm.astro';
import { db } from '../../../db';
import { event } from '../../../db/schema/content';

const { id } = Astro.params;
const result = Astro.getActionResult(actions.admin.saveEvent);

const [existing] = id ? await db.select().from(event).where(eq(event.id, id)).limit(1) : [];

if (!existing) {
  return Astro.rewrite('/404');
}

const saved = Astro.url.searchParams.get('saved') === '1' || (result && !result.error);
---

<AdminLayout title={`${existing.title} | Admin`} heading="Edit event">
  {
    saved && (
      <p class="mb-6 rounded-lg border border-green-500/20 bg-green-500/10 px-4 py-3 text-sm text-green-700 dark:text-green-400">
        Saved.{' '}
        <a class="underline" href={`/events/${existing.slug}`}>
          View it on the site
        </a>
        .
      </p>
    )
  }
  <EventForm event={existing} error={result?.error?.message} />
</AdminLayout>
