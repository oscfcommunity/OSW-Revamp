---
import { CONTENT_SOURCE, STRAPI_URL } from 'astro:env/server';
import { count } from 'drizzle-orm';

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db';
import { submission } from '../../db/schema/content';
import { user } from '../../db/schema/auth';
import { forumPost, forumReport, forumThread } from '../../db/schema/forum';
import { ExternalLink } from 'lucide-astro';

const [users, threads, posts, reports, submissions] = await Promise.all([
  db.select({ value: count() }).from(user),
  db.select({ value: count() }).from(forumThread),
  db.select({ value: count() }).from(forumPost),
  db.select({ value: count() }).from(forumReport),
  db.select({ value: count() }).from(submission),
]);

const stats = [
  { label: 'Members', value: users[0]?.value ?? 0, href: '/admin/users' },
  { label: 'Threads', value: threads[0]?.value ?? 0, href: '/forum' },
  { label: 'Posts', value: posts[0]?.value ?? 0, href: '/forum' },
  { label: 'Open reports', value: reports[0]?.value ?? 0, href: '/admin' },
  { label: 'Submissions', value: submissions[0]?.value ?? 0, href: '/admin' },
] as const;

// The CMS is a separate application; link to it rather than duplicating it.
const cmsUrl = STRAPI_URL ? `${STRAPI_URL.replace(/\/$/, '')}/admin` : '/admin-cms';
---

<AdminLayout
  title="Admin | Open Source Weekend"
  heading="Dashboard"
  description="Members, moderation and the forum."
>
  <section class="grid grid-cols-2 gap-4 md:grid-cols-5">
    {
      stats.map((stat) => (
        <a
          href={stat.href}
          class="bg-card border-border hover:border-primary rounded-xl border p-5 transition-colors"
        >
          <p class="font-['Outfit'] text-3xl font-extrabold">{stat.value}</p>
          <p class="text-muted-foreground mt-1 text-sm">{stat.label}</p>
        </a>
      ))
    }
  </section>

  <section class="bg-card border-border mt-8 rounded-xl border p-6">
    <h2 class="text-lg font-bold">Events and jobs</h2>
    <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
      Content is edited in the Strapi CMS, not here. The site is currently reading events and jobs
      from
      <strong class="text-foreground">
        {CONTENT_SOURCE === 'strapi' ? 'the CMS' : 'the Google Sheets'}
      </strong>.
      {
        CONTENT_SOURCE !== 'strapi' && (
          <>
            {' '}
            Once the CMS is populated, set
            <code class="bg-muted mx-1 rounded px-1.5 py-0.5 text-xs">CONTENT_SOURCE=strapi</code>
            and restart.
          </>
        )
      }
    </p>
    <a
      href={cmsUrl}
      class="text-primary mt-4 inline-flex items-center gap-1.5 text-sm font-semibold"
    >
      Open the CMS <ExternalLink class="size-3.5" />
    </a>
  </section>
</AdminLayout>
