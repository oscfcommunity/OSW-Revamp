---
import { actions } from 'astro:actions';
import { desc } from 'drizzle-orm';
import { ExternalLink, Pencil, Plus } from 'lucide-astro';

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { job } from '../../../db/schema/content';

const rows = await db.select().from(job).orderBy(desc(job.postedOn));

const formatDate = (value: Date | null): string =>
  value
    ? value.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    : '—';
---

<AdminLayout title="Jobs | Admin" heading="Jobs" description={`${rows.length} in the database.`}>
  <div class="mb-6">
    <a
      href="/admin/jobs/new"
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center gap-2 rounded-lg px-4 text-sm font-bold"
    >
      <Plus class="size-4" /> New job
    </a>
  </div>

  {
    rows.length === 0 ? (
      <p class="border-border text-muted-foreground rounded-xl border border-dashed p-10 text-center">
        No jobs yet. Import from Google Sheets on the dashboard, or create one.
      </p>
    ) : (
      <div class="border-border overflow-x-auto rounded-xl border">
        <table class="w-full text-sm">
          <thead class="bg-muted/40 text-muted-foreground text-left text-xs uppercase">
            <tr>
              <th class="px-4 py-3 font-semibold">Role</th>
              <th class="px-4 py-3 font-semibold">Company</th>
              <th class="px-4 py-3 font-semibold">Posted</th>
              <th class="px-4 py-3 font-semibold">Status</th>
              <th class="px-4 py-3" />
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="border-border/60 border-t">
                <td class="px-4 py-3">
                  <span class="font-medium">{row.title}</span>
                  <span class="text-muted-foreground block text-xs">{row.slug}</span>
                </td>
                <td class="text-muted-foreground px-4 py-3">{row.company}</td>
                <td class="text-muted-foreground px-4 py-3 whitespace-nowrap">
                  {formatDate(row.postedOn)}
                </td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'rounded-full px-2 py-0.5 text-xs font-semibold',
                      row.status === 'open'
                        ? 'bg-green-500/10 text-green-600 dark:text-green-400'
                        : 'bg-muted text-muted-foreground',
                    ]}
                  >
                    {row.status}
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-3">
                    <a
                      href={`/jobs/${row.slug}`}
                      class="text-muted-foreground hover:text-primary"
                      aria-label="View"
                    >
                      <ExternalLink class="size-4" />
                    </a>
                    <a
                      href={`/admin/jobs/${row.id}`}
                      class="text-muted-foreground hover:text-primary"
                      aria-label="Edit"
                    >
                      <Pencil class="size-4" />
                    </a>
                    <form
                      method="POST"
                      action={actions.admin.deleteJob}
                      data-confirm={`Delete "${row.title}"?`}
                    >
                      <input type="hidden" name="id" value={row.id} />
                      <button
                        type="submit"
                        class="text-muted-foreground hover:text-destructive text-xs font-semibold"
                      >
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (submitEvent) => {
      if (!window.confirm(form.dataset.confirm ?? 'Are you sure?')) {
        submitEvent.preventDefault();
      }
    });
  });
</script>
