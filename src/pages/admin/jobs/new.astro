---
import { actions } from 'astro:actions';

import AdminLayout from '../../../layouts/AdminLayout.astro';
import JobForm from '../../../components/admin/JobForm.astro';

const result = Astro.getActionResult(actions.admin.saveJob);

if (result && !result.error) {
  return Astro.redirect(`/admin/jobs/${result.data.id}?saved=1`);
}
---

<AdminLayout title="New job | Admin" heading="New job">
  <JobForm error={result?.error?.message} />
</AdminLayout>
