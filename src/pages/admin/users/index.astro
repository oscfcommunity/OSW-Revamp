---
import { actions } from 'astro:actions';
import { desc } from 'drizzle-orm';

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { user } from '../../../db/schema/auth';
import { isAdmin } from '../../../lib/guards';

const rows = await db.select().from(user).orderBy(desc(user.createdAt));
const viewer = Astro.locals.viewer;
const canChangeRoles = isAdmin(viewer);
const roleResult = Astro.getActionResult(actions.moderation.setUserRole);
const banResult = Astro.getActionResult(actions.moderation.banUser);
const error = roleResult?.error?.message ?? banResult?.error?.message;

const isCurrentlyBanned = (bannedUntil: Date | null): boolean =>
  bannedUntil !== null && bannedUntil > new Date();
---

<AdminLayout title="Members | Admin" heading="Members" description={`${rows.length} registered.`}>
  {
    error && (
      <p class="border-destructive/20 bg-destructive/10 text-destructive mb-6 rounded-lg border px-4 py-3 text-sm">
        {error}
      </p>
    )
  }

  <div class="border-border overflow-x-auto rounded-xl border">
    <table class="w-full text-sm">
      <thead class="bg-muted/40 text-muted-foreground text-left text-xs uppercase">
        <tr>
          <th class="px-4 py-3 font-semibold">Member</th>
          <th class="px-4 py-3 font-semibold">Joined</th>
          <th class="px-4 py-3 font-semibold">Rep</th>
          <th class="px-4 py-3 font-semibold">Role</th>
          <th class="px-4 py-3 font-semibold">Access</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-border/60 border-t">
              <td class="px-4 py-3">
                <span class="font-medium">{row.name}</span>
                <span class="text-muted-foreground block text-xs">{row.email}</span>
              </td>
              <td class="text-muted-foreground px-4 py-3 whitespace-nowrap">
                {row.createdAt.toLocaleDateString('en-GB')}
              </td>
              <td class="text-muted-foreground px-4 py-3">{row.reputation}</td>
              <td class="px-4 py-3">
                {canChangeRoles && row.id !== viewer?.id ? (
                  <form method="POST" action={actions.moderation.setUserRole} class="flex gap-2">
                    <input type="hidden" name="userId" value={row.id} />
                    <select
                      name="role"
                      class="border-border bg-background rounded-lg border px-2 py-1 text-xs"
                    >
                      {['user', 'moderator', 'admin'].map((role) => (
                        <option value={role} selected={role === row.role}>
                          {role}
                        </option>
                      ))}
                    </select>
                    <button type="submit" class="text-primary text-xs font-semibold">
                      Set
                    </button>
                  </form>
                ) : (
                  <span class="text-muted-foreground">{row.role}</span>
                )}
              </td>
              <td class="px-4 py-3">
                <form
                  method="POST"
                  action={actions.moderation.banUser}
                  class="flex items-center gap-2"
                >
                  <input type="hidden" name="userId" value={row.id} />
                  <input
                    type="number"
                    name="days"
                    min="0"
                    max="3650"
                    value={isCurrentlyBanned(row.bannedUntil) ? 0 : 7}
                    class="border-border bg-background w-16 rounded-lg border px-2 py-1 text-xs"
                    aria-label="Days"
                  />
                  <button type="submit" class="hover:text-destructive text-xs font-semibold">
                    {isCurrentlyBanned(row.bannedUntil) ? 'Unban (0)' : 'Suspend'}
                  </button>
                </form>
                {isCurrentlyBanned(row.bannedUntil) && (
                  <span class="text-destructive block text-xs">
                    until {row.bannedUntil?.toLocaleDateString('en-GB')}
                  </span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
