---
// SSR for fresh data

import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import EventCard from '../components/EventCard.astro';
import JobCard from '../components/JobCard.astro';
import Terminal from '../components/Terminal.astro';
import { getEvents } from '../lib/events';
import { getJobs } from '../lib/jobs';

// Fetch Data
const upcomingEvents = (await getEvents())
    .filter(e => new Date(e.endDate) >= new Date())
    .sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime())
    .slice(0, 3); // Top 3 events

const featuredJobs = (await getJobs())
    .filter(j => j.status === 'Open')
    .sort((a, b) => {
        // 1. Featured Priority
        if (a.featured && !b.featured) return -1;
        if (!a.featured && b.featured) return 1;
        // 2. Date Priority
        const timeA = isNaN(a.postedOn.getTime()) ? 0 : a.postedOn.getTime();
        const timeB = isNaN(b.postedOn.getTime()) ? 0 : b.postedOn.getTime();
        return timeB - timeA;
    })
    .slice(0, 3); // Top 3 jobs
---

<Layout title="Open Source Weekend | Connect, Share, Thrive">
  <!-- Hero Section -->
  <section class="py-12 md:py-24 relative overflow-hidden">
    <!-- Background Gradient Blob -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/10 blur-[100px] rounded-full -z-10 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left Column: Text -->
      <div class="space-y-8 text-center lg:text-left">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium border border-primary/20 mb-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            Join the movement
          </div>
          
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-foreground font-['Outfit'] leading-tight">
             Connect. Code. <br/>
             <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Create Together.</span>
          </h1>
          <p class="text-xl text-muted-foreground font-light leading-relaxed max-w-xl mx-auto lg:mx-0">
            A community-driven initiative empowering developers through events, mentorship, and open source collaboration.
          </p>
        </div>
        
        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
          <Button href="/events" size="lg" class="rounded-full px-8 text-base shadow-lg shadow-primary/20">
            Join Upcoming Events
          </Button>
          <Button href="/jobs" variant="outline" size="lg" class="rounded-full px-8 text-base">
            Browse Job Board
          </Button>
        </div>
      </div>

      <!-- Right Column: Terminal -->
      <div class="relative hidden lg:block">
         <!-- Abstract Decorative Elements -->
         <div class="absolute -top-10 -right-10 w-24 h-24 bg-secondary/20 rounded-full blur-2xl"></div>
         <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-primary/20 rounded-full blur-2xl"></div>
         
         <Terminal />
      </div>

    </div>
  </section>

  <!-- Content Sections -->
  <div class="space-y-20 pb-20 max-w-6xl mx-auto px-4">
    
    <!-- About Community -->
    <section class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <h2 class="text-3xl font-bold font-['Outfit']">
          What is <span class="text-primary">OSW</span>?
        </h2>
        <div class="space-y-4 text-muted-foreground text-lg leading-relaxed">
          <p>
            Open Source Weekend is a volunteer-run community dedicated to connecting developers, designers, and tech enthusiasts. We believe in the power of code to bring people together.
          </p>
          <p>
            Whether you're a seasoned maintainer or writing your first "Hello World", there's a place for you here. We organize hackathons, devfests, and workshops to foster learning and collaboration.
          </p>
        </div>
      </div>
      <div class="bg-muted/30 rounded-2xl p-8 border border-border">
         <div class="grid grid-cols-2 gap-6">
            <div class="text-center p-4 bg-background rounded-xl shadow-sm">
                <span class="block text-4xl font-bold text-primary mb-2">50+</span>
                <span class="text-sm text-muted-foreground">Events Hosted</span>
            </div>
            <div class="text-center p-4 bg-background rounded-xl shadow-sm">
                <span class="block text-4xl font-bold text-secondary mb-2">2k+</span>
                <span class="text-sm text-muted-foreground">Community Members</span>
            </div>
            <div class="text-center p-4 bg-background rounded-xl shadow-sm">
                <span class="block text-4xl font-bold text-primary mb-2">10+</span>
                <span class="text-sm text-muted-foreground">Cities Reached</span>
            </div>
            <div class="text-center p-4 bg-background rounded-xl shadow-sm">
                <span class="block text-4xl font-bold text-secondary mb-2">∞</span>
                <span class="text-sm text-muted-foreground">Lines of Code</span>
            </div>
         </div>
      </div>
    </section>

    <!-- upcoming events -->
    <section class="space-y-8">
      <div class="flex items-center justify-between px-2">
        <h2 class="text-3xl font-bold font-['Outfit'] flex items-center gap-2">
          📅 Upcoming Events
        </h2>
        <Button href="/events" variant="ghost" class="group">
          View all events <span class="group-hover:translate-x-1 transition-transform">→</span>
        </Button>
      </div>
      
      {upcomingEvents.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {upcomingEvents.map(event => (
              <EventCard event={event} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center border border-dashed border-border rounded-xl bg-muted/30">
            <p class="text-muted-foreground">No upcoming events right now. Check back soon!</p>
        </div>
      )}
    </section>

    <!-- Latest Jobs -->
    <section class="space-y-8">
      <div class="flex items-center justify-between px-2">
        <h2 class="text-3xl font-bold font-['Outfit'] flex items-center gap-2">
           Latest Jobs
        </h2>
        <Button href="/jobs" variant="ghost" class="group">
          View all jobs <span class="group-hover:translate-x-1 transition-transform">→</span>
        </Button>
      </div>

      {featuredJobs.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredJobs.map(job => (
            <JobCard job={job} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center border border-dashed border-border rounded-xl bg-muted/30">
            <p class="text-muted-foreground">No open positions right now. Check back later!</p>
        </div>
      )}
    </section>

  </div>
</Layout>
