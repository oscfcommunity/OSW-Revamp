---

import Layout from '../../layouts/Layout.astro';
import { MapPin, Briefcase, Building2, Monitor, Clock, ChevronLeft, ExternalLink, Users } from 'lucide-astro';
import { getJob } from '../../lib/jobs';
import { marked } from 'marked';

// Design System
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import SkillTag from '../../components/ui/SkillTag.astro';
import IconText from '../../components/ui/IconText.astro';

const { slug } = Astro.params;
const job = await getJob(slug!);

if (!job) {
  return Astro.redirect('/404');
}

const { title, company, jobType, jobMode, location, postedOn, skills, experience, companyWebsite, applyLink, aboutCompany } = job;
const contentHtml = await marked.parse(job.description || '');

// Safely format the posted date
let formattedPostedDate = 'Recently';
try {
  if (!isNaN(postedOn.getTime())) {
    formattedPostedDate = postedOn.toLocaleDateString();
  }
} catch (error) {
  console.error('Error formatting date:', error);
}

const description = `Apply for ${title} at ${company}. ${experience} experience required.`;
---

<Layout title={`${title} at ${company} | TechJobs`} description={description}>
  <div class="space-y-8 max-w-4xl mx-auto px-4 py-8">
    <Button href="/" variant="ghost" size="sm" class="pl-0 hover:bg-transparent hover:text-primary">
      <ChevronLeft class="size-4 mr-1" /> Back to Jobs
    </Button>

    <div class="bg-card border border-border rounded-2xl p-8 md:p-10 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
        <div class="space-y-6 flex-1">
          <div>
            <h1 class="text-3xl md:text-5xl font-['Plus_Jakarta_Sans'] font-extrabold text-foreground tracking-tight leading-tight">{title}</h1>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground mt-4">
              <IconText icon={Building2} text={company} href={companyWebsite} target="_blank" rel="noopener noreferrer" />
              <IconText icon={Briefcase} text={job.jobType} />
              <IconText icon={MapPin} text={job.location} />
              <IconText icon={Monitor} text={job.jobMode} />
              <IconText icon={Clock} text={`Posted ${new Date(job.postedOn).toLocaleDateString()}`} />
              <IconText icon={Users} text={`${job.openings} Opening${job.openings !== '1' ? 's' : ''}`} />
            </div>
          </div>

        </div>

        <div class="flex flex-col gap-4 min-w-[200px]">
          {job.status === 'Closed' ? (
            <Button disabled variant="secondary" size="lg" class="w-full opacity-50 cursor-not-allowed">
              Position Filled
            </Button>
          ) : (
            <Button href={applyLink} target="_blank" rel="noopener noreferrer" size="lg" class="w-full shadow-lg hover:-translate-y-0.5">
              Apply Now <ExternalLink class="size-4" />
            </Button>
          )}
          
          <div class="text-center text-sm text-muted-foreground bg-muted/30 py-3 rounded-lg border border-border/30">
            Experience: <span class="font-bold text-foreground block mt-0.5">{experience}</span>
          </div>
        </div>
      </div>
      
      {job.status === 'Closed' && (
        <div class="mt-8 bg-destructive/10 border border-destructive/20 text-destructive px-4 py-3 rounded-lg flex items-center gap-2 font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban w-5 h-5"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
          This job is currently closed and no longer accepting applications.
        </div>
      )}

      <div class="mt-10 border-t border-border pt-8">
        <h3 class="text-xs font-bold text-muted-foreground uppercase tracking-widest mb-4">Required Skills</h3>
        <div class="flex flex-wrap gap-2.5">
          {skills.map((skill: string) => (
            <SkillTag skill={skill} />
          ))}
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="md:col-span-2 space-y-8">
        <article class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-['Plus_Jakarta_Sans'] prose-headings:font-bold prose-headings:tracking-tight prose-p:leading-relaxed prose-a:text-primary hover:prose-a:text-primary/80 prose-li:marker:text-primary bg-card p-8 md:p-12 rounded-2xl border border-border shadow-sm" set:html={contentHtml} />
      </div>

      <div class="md:col-span-1 space-y-6">
        {aboutCompany && (
          <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
            <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
              <Building2 class="size-5 text-primary" /> About {company}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {aboutCompany}
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
