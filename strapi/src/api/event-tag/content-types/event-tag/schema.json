{
  "kind": "collectionType",
  "collectionName": "event_tags",
  "info": { "singularName": "event-tag", "pluralName": "event-tags", "displayName": "Event tag" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "mappedBy": "event_tags"
    }
  }
}
